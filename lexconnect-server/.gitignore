# LexConnect Server .gitignore

# Dependencies
node_modules/
.pnpm-store/

# Environment Variables & Secret Files (CRITICAL: DO NOT COMMIT REAL CREDENTIALS)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*.local
.env.*
!.env.example

# Credentials & Keys
*.pem
*.key
*.crt
*.pfx
*.p12

# Uploads & Media Storage (Preserve folder structure via .gitkeep)
uploads/*
!uploads/.gitkeep

# Logs & Debug Output
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Database & Local Stores
*.sqlite
*.sqlite3
*.db
*.sql

# System & Editor Files
.DS_Store
Thumbs.db
Desktop.ini
.vscode/
.idea/
